# Copy this file to `.env` and fill in real keys before running the app.
# NEVER commit a real `.env`. It is gitignored.

# Plant.id v3 API key — https://web.plant.id/
# Free tier: 100 identifications.
PLANT_ID_API_KEY=

# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on your project first.
YOUTUBE_API_KEY=
