# Copy this file to `.env` and fill in real keys before running the app.
# NEVER commit a real `.env`. It is gitignored.

# ---------------------------------------------------------------------------
# Plant identification
# ---------------------------------------------------------------------------
# The app defaults to calling the project's public Hugging Face Space at
# https://edgarphiri1-african-doctor-classifier.hf.space/api/classify which
# hosts `dima806/medicinal_plants_image_detection`. No credentials are
# required in the default configuration — you can run `flutter run` with
# only the YouTube key below and identification will work.

# Optional: point the classifier at a different HF Space or custom REST
# endpoint that accepts a multipart `image` field and returns
# `[{"label": "...", "score": 0.0-1.0}, ...]`.
HF_ENDPOINT_URL=

# Optional: fallback for calling the HF serverless Inference router
# directly. Only used when HF_ENDPOINT_URL is blank and HF_MODEL_ID names
# a model that is deployed on the shared `hf-inference` provider (e.g.
# `google/vit-base-patch16-224`, `microsoft/resnet-50`). Requires an HF
# read token: https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL_ID=

# ---------------------------------------------------------------------------
# Community videos
# ---------------------------------------------------------------------------
# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on your project first.
YOUTUBE_API_KEY=
