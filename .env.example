# Copy this file to `.env` and fill in real keys before running the app.
# NEVER commit a real `.env`. It is gitignored.

# Hugging Face API token — REQUIRED for plant identification.
# Sign up: https://huggingface.co/join (30 seconds, email + password).
# Create a Read token: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Optional: override the default medicinal-plant classification model.
# Default: dima806/medicinal_plants_image_detection
HF_MODEL_ID=

# Optional: point at a dedicated HF Inference Endpoint instead of the free
# shared router (useful for production when you hit the rate limit).
HF_ENDPOINT_URL=

# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on your project first.
YOUTUBE_API_KEY=
